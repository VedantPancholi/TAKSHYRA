# Development only. Generate unique local values before starting Compose.
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD
DEMO_A_EXECUTOR_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD
DEMO_A_VIEWER_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD
DEMO_A_APPROVER_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD
DEMO_B_EXECUTOR_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD
DEMO_B_VIEWER_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD
DEMO_B_APPROVER_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD
# Set seven different random values, each at least 16 characters.
# Compose binds the API to 127.0.0.1; do not expose it beyond your machine.
# M4 contracts use the existing database and artifact volume; no extra credentials are needed.
# M5 local lineage uses the existing database and demo identities; no external connector credentials are needed.
# M6 web console is served at http://127.0.0.1:3000 and uses the same demo identities.
